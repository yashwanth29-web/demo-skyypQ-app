# SkyypQ Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Replace with your Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/skyyq?retryWrites=true&w=majority

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── CORS Origins (comma-separated) ─────────────────────────────────────────
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Node Environment ────────────────────────────────────────────────────────
NODE_ENV=development
